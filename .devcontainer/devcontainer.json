{
  "name": "asciidoctor-slides",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "git.rebaseWhenSync": true,
        "remote.restoreForwardedPorts": false,
        "remote.autoForwardPorts": true,
        "typescript.preferences.quoteStyle": "single"
      },
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "wesbos.theme-cobalt2",
        "EditorConfig.EditorConfig",
        "dzhavat.git-cheatsheet",
        "PKief.material-icon-theme",
        "ms-azuretools.vscode-docker",
        "adpyke.codesnap",
        "ritwickdey.LiveServer",
        "yandeu.five-server",
        "asciidoctor.asciidoctor-vscode",
        "google.geminicodeassist"
      ]
    }
  },
  "service": "revealjs-slides",
  "workspaceFolder": "/src",
  //"remoteUser": "root",
  //"postStartCommand": "groovy printDevContainer.groovy ",
  "postCreateCommand": "npm i --save asciidoctor @asciidoctor/reveal.js && npm install",
  "postStartCommand": "npm run watch", //:adoc",
  "shutdownAction": "stopCompose"
}